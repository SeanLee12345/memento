# Local Supabase Edge development only. Do not embed provider keys in iOS.
DASHSCOPE_API_KEY=
DEEPSEEK_API_KEY=
WORKER_TOKEN_SIGNING_SECRET=
NVIDIA_API_KEY=
NVIDIA_EMBEDDING_MODEL=nvidia/llama-nemotron-embed-1b-v2
NVIDIA_EMBEDDING_URL=https://integrate.api.nvidia.com/v1/embeddings
DEEPSEEK_MODEL=deepseek-v4-flash
OPEN_SOURCE_TTS_ENABLED=false
OPEN_SOURCE_TTS_ENDPOINT=http://127.0.0.1:5000
OPEN_SOURCE_TTS_VOICE=en_US-lessac-medium

# Alibaba Cloud Model Studio / DashScope Edge Function defaults.
LIVE_ASR_PROVIDER=localParakeet
# FluidAudio downloads and caches the selected Core ML model on first use.
# Options: parakeet-tdt-ctc-110m (default), v2, v3.
PARAKEET_ASR_MODEL_NAME=parakeet-tdt-ctc-110m
DASHSCOPE_BASE_URL=https://dashscope-us.aliyuncs.com/compatible-mode/v1
DASHSCOPE_QA_BASE_URL=https://dashscope-us.aliyuncs.com/compatible-mode/v1
DASHSCOPE_GENERATION_BASE_URL=https://dashscope-us.aliyuncs.com/api/v1
DASHSCOPE_QA_MODEL=qwen3.5-flash
DASHSCOPE_TEXT_MODEL=qwen3.5-flash
DASHSCOPE_VL_MODEL=qwen3-vl-flash-us
DASHSCOPE_ASR_MODEL=qwen3-asr-flash-us
DASHSCOPE_SEARCH_STRATEGY=turbo

# AWS worker local-debug fallback only. Production iOS should use worker-session
# short-lived tokens and workers should validate WORKER_TOKEN_SIGNING_SECRET.
CLOUD_FACE_EMBEDDING_ENDPOINT=
FACE_WORKER_API_KEY=
SPEAKER_WORKER_API_KEY=

# Supabase — copy values from the dashboard for your own project.
#   ACCESS_TOKEN: Management API PAT for CLI / migrations from your laptop.
#                 NEVER embedded in the iOS binary.
#   PROJECT_REF + URL: pin the project the app talks to.
#   ANON_KEY: the only Supabase key the iOS app needs. Per-row access is
#             enforced by RLS keyed on auth.uid() (see supabase/migrations/
#             0002_owner_rls.sql). The app mints a per-install session JWT
#             via SupabaseSession (anonymous Supabase Auth) on first launch.
#   SERVICE_KEY: NOT used by the app. Optional escape hatch for emergency
#                admin work via psql or scripts on your laptop.
SUPABASE_ACCESS_TOKEN=
SUPABASE_PROJECT_REF=
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_KEY=
